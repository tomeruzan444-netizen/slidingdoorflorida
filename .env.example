# Public site URL once the domain is live (falls back to business.ts domain)
NEXT_PUBLIC_SITE_URL=
# Quote form email delivery (Resend). Without these the form returns an error and asks visitors to call.
RESEND_API_KEY=
QUOTE_TO_EMAIL=
QUOTE_FROM_EMAIL=
# Set to 1 to make the build fail on any remaining {{PLACEHOLDER}} (automatic on Vercel production)
STRICT_PLACEHOLDERS=
